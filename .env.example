# Copy to .env.local and fill in. Everything is optional — features turn on when set.

# Your real domain (used for canonical URLs, sitemap, schema, OG images)
NEXT_PUBLIC_SITE_URL=https://www.usemetron.com

# Google Search Console — the content="…" value from the HTML tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics + Google Ads
NEXT_PUBLIC_GA_ID=                     # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=             # e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=     # conversion label for "Lead form submit"
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=     # conversion label for "Phone click"
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=  # conversion label for "Booked sales call" (Cal.com)
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL= # conversion label for "Purchase" (Stripe → /welcome)

# Lead delivery (configure at least one before launch — production rejects leads otherwise)
LEAD_WEBHOOK_URL=                      # Zapier / Make / n8n / GoHighLevel / HubSpot webhook
RESEND_API_KEY=                        # https://resend.com — email notifications
LEAD_NOTIFY_EMAIL=eeharris2004@gmail.com # comma-separated recipients
LEAD_FROM_EMAIL=                       # e.g. "Metron <leads@usemetron.com>" (verified sender)

# Stripe Payment Links (one per plan) — Buy buttons go here. Leave blank to fall back to the contact form.
NEXT_PUBLIC_STRIPE_LINK_LAUNCH=
NEXT_PUBLIC_STRIPE_LINK_GROWTH=
NEXT_PUBLIC_STRIPE_LINK_SCALE=
NEXT_PUBLIC_STRIPE_LINK_ENTERPRISE=
