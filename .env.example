# Copy to .env.local and fill in. Everything is optional — features turn on when set.

# Your real domain (used for canonical URLs, sitemap, schema, OG images)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Analytics + Google Ads
NEXT_PUBLIC_GA_ID=                     # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=             # e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=     # conversion label for "Lead form submit"
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=     # conversion label for "Phone click"

# Lead delivery (configure at least one before launch — production rejects leads otherwise)
LEAD_WEBHOOK_URL=                      # Zapier / Make / n8n / GoHighLevel / HubSpot webhook
RESEND_API_KEY=                        # https://resend.com — email notifications
LEAD_NOTIFY_EMAIL=                     # comma-separated recipients
LEAD_FROM_EMAIL=                       # e.g. "Automatix <leads@yourdomain.com>" (verified sender)
